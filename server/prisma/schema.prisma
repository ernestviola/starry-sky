generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model HygStar {
  id           Int     @id
  healpixId    Int?
  hip          Int?
  hd           Int?
  hr           Int?
  gl           String?
  bf           String?
  proper       String?
  ra           Float
  dec          Float
  dist         Float?
  pmra         Float?
  pmdec        Float?
  rv           Float?
  mag          Float?
  absmag       Float?
  spect        String?
  ci           Float?
  x            Float?
  y            Float?
  z            Float?
  vx           Float?
  vy           Float?
  vz           Float?
  rarad        Float?
  decrad       Float?
  pmrarad      Float?
  pmdecrad     Float?
  bayer        String?
  flam         Int?
  con          String?
  comp         Int?
  comp_primary Int?
  base         String?
  lum          Float?
  var          String?
  var_min      Float?
  var_max      Float?

  @@map("hyg_stars")
}
